MCP_AUDIT_ENVIRONMENT=development
MCP_AUDIT_DEBUG=false
MCP_AUDIT_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/mcp_audit
MCP_AUDIT_REDIS_BROKER_URL=redis://redis:6379/0
MCP_AUDIT_REDIS_RESULT_URL=redis://redis:6379/1
MCP_AUDIT_TASK_TIME_LIMIT_SECONDS=900
MCP_AUDIT_CLONE_TIMEOUT_SECONDS=180
MCP_AUDIT_TASK_RETRY_DELAY_SECONDS=15
MCP_AUDIT_SEMGREP_TIMEOUT_SECONDS=300
MCP_AUDIT_SEMGREP_RULE_TIMEOUT_SECONDS=10
MCP_AUDIT_SEMGREP_MAX_TARGET_BYTES=2000000
MCP_AUDIT_OSV_TIMEOUT_SECONDS=20
MCP_AUDIT_DEPENDENCY_LIMIT=5000
MCP_AUDIT_SECRET_SCAN_MAX_FILE_BYTES=2000000
MCP_AUDIT_ALLOWED_REPO_HOSTS=["github.com","gitee.com","gitlab.com"]
MCP_AUDIT_REPOSITORY_MAX_BYTES=250000000
MCP_AUDIT_REPOSITORY_MAX_FILES=50000

